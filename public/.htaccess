Options -Indexes

RewriteEngine On

# Block direct browser access to sensitive backend folders (production security)
RewriteRule ^(config|src|views|database|scripts|sessions)(/.*)?$ - [F,L]

# Allow direct access to real files (css, js, images, uploads)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Send everything else to index.php
RewriteRule ^(.*)$ index.php [QSA,L]
