# CardVault Environment Configuration
# Rename this file to .env and fill in your values.

# Application — auto-detected from Apache ServerName, usually no need to set
# APP_URL=https://your-server-ip-or-domain

# Database
DB_HOST=localhost
DB_NAME=cardvault
DB_USER=cardvault_user
DB_PASS=your_mysql_password_here

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=CardVault
